APP_NAME="GigMatch AI Backend"
APP_ENV="development"
FRONTEND_ORIGIN="http://localhost:5173"

# Future Supabase integration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key"
SUPABASE_SECRET_KEY="sb_secret_your_secret_key"

# Future AI configuration
EMBEDDING_MODEL_NAME=""

# Structured Q&A and linked proposal revision policy
QA_MESSAGE_BURST_LIMIT=8
QA_MESSAGE_BURST_MINUTES=10
QA_MESSAGE_DAILY_LIMIT=40
QA_REVISION_DAILY_LIMIT=3
QA_MESSAGE_PAGE_SIZE=30

# Secure Contact Exchange. Generate independent 32-byte base64 keys.
# Keep old encryption key IDs in the JSON map during key rotation.
CONTACT_ACTIVE_ENCRYPTION_KEY_ID="contact-v1"
CONTACT_ENCRYPTION_KEYS_JSON="{\"contact-v1\":\"replace-with-32-byte-base64-key\"}"
CONTACT_FINGERPRINT_KEY_BASE64="replace-with-independent-32-byte-base64-key"
CONTACT_REVEAL_RATE_LIMIT=10
CONTACT_REVEAL_RATE_WINDOW_MINUTES=10
