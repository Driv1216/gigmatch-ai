# GigMatch AI environment reference.
# Prefer frontend/.env.example and backend/.env.example for local setup.

# Frontend
VITE_APP_NAME="GigMatch AI"
VITE_API_BASE_URL="http://localhost:8000"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key"
VITE_GOOGLE_AUTH_ENABLED="false"

# Backend
APP_NAME="GigMatch AI Backend"
APP_ENV="development"
FRONTEND_ORIGIN="http://localhost:5173"

# Supabase Auth verification and trusted server-side data access
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key"
SUPABASE_SECRET_KEY="sb_secret_your_secret_key"

# Optional semantic ranking. Install sentence-transformers separately to use it.
EMBEDDING_MODEL_NAME=""

APPLICANT_SHORTLIST_CAPACITY=5
APPLICANT_ADVANCEMENT_CAPACITY=5

QA_MESSAGE_BURST_LIMIT=8
QA_MESSAGE_BURST_MINUTES=10
QA_MESSAGE_DAILY_LIMIT=40
QA_REVISION_DAILY_LIMIT=3
QA_MESSAGE_PAGE_SIZE=30

# Generate independent 32-byte base64 encryption and fingerprint keys.
CONTACT_ACTIVE_ENCRYPTION_KEY_ID="contact-v1"
CONTACT_ENCRYPTION_KEYS_JSON="{\"contact-v1\":\"replace-with-32-byte-base64-key\"}"
CONTACT_FINGERPRINT_KEY_BASE64="replace-with-independent-32-byte-base64-key"
CONTACT_REVEAL_RATE_LIMIT=10
CONTACT_REVEAL_RATE_WINDOW_MINUTES=10
